# Copy to .env for local runs (`make run`, `make eval`, `make test-live`, `make docker-run`).
# Do not quote values: `docker --env-file` passes quotes through literally.

# Path prefix the service is mounted under behind the ingress (empty locally)
BASE_URL=

LOG_LEVEL=INFO
# JSON logs for Kubernetes, human-readable console logs otherwise
LOG_JSON=false

# SCAYLE LLM API. Dev goes through the proxy below (VPN, self-signed certificate).
SCAYLE_BASE_URL=https://172.16.59.5:32443/api
SCAYLE_USERNAME=username
SCAYLE_PASSWORD=password
SCAYLE_VERIFY_SSL=false
# Read timeout of one LLM call, in seconds
SCAYLE_TIMEOUT=20

# Model ids are case sensitive and renamed from time to time; /monitoring/health-check
# reports whether this one is still listed.
INTENT_MODEL=qwen3.8-flash-next
# Let the model reason before answering. Slower, and the reasoning counts against
# INTENT_MAX_TOKENS.
INTENT_ENABLE_THINKING=false
INTENT_MAX_TOKENS=1024
# dataset_search / question answers below this confidence are returned as ambiguous
INTENT_MIN_CONFIDENCE=0.6

# Bearer token validation against the DataGEMS AAI (Keycloak)
ENABLE_AUTH=false
OIDC_ISSUER=https://datagems-dev.scayle.es/oauth/realms/dev
# Required "aud" claim value; set to an empty value to skip the check
OIDC_AUDIENCE=dg-intent-disambiguation
OIDC_VERIFY_SSL=true
